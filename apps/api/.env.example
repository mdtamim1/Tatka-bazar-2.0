# =============================================================================
# Tatka Bazar — API Server Environment Variables
# Copy this file to .env and fill in the real values
# =============================================================================

# ── Database (Supabase / Neon / Railway PostgreSQL) ──────────────────────────
# Connection pooler URL (used by Prisma in production)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/tatka_bazar?pgbouncer=true

# Direct connection URL (used for Prisma migrations — bypasses pooler)
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/tatka_bazar

# ── Redis (Upstash / Railway Redis) ──────────────────────────────────────────
REDIS_URL=redis://default:[PASSWORD]@[HOST]:6379

# ── JWT Auth ─────────────────────────────────────────────────────────────────
# MUST be at least 64 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_64_CHAR_RANDOM_STRING
JWT_EXPIRY=7d

# ── Server Config ─────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=production

# ── CORS — Allowed Frontend Origins ──────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=https://rider.tatkabazar.com,https://hub-gamma-umber.vercel.app,https://tatka-bazar-2-0-storefront.vercel.app

# ── Firebase Admin SDK (for real FCM push notifications) ─────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Private key: copy the entire key including BEGIN/END lines, keep \n as literal \n
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQEFAAS...\n-----END PRIVATE KEY-----\n"

# ── Payment Gateways ──────────────────────────────────────────────────────────
# SSLCommerz
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# bKash
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_app_key
BKASH_APP_SECRET=your_app_secret
BKASH_USERNAME=your_username
BKASH_PASSWORD=your_password

# ── Storefront URL (for payment callbacks) ────────────────────────────────────
STOREFRONT_URL=https://tatka-bazar-2-0-storefront.vercel.app
