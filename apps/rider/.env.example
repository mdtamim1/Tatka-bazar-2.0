# =======================================================
# Tatka Bazar Rider App — Environment Variables
# Copy this file to .env.local and fill in the values
# =======================================================

# ── Core API ────────────────────────────────────────────
# Production: https://api.tatkabazar.com
# Local Dev:  http://localhost:4000
NEXT_PUBLIC_API_URL=https://api.tatkabazar.com

# ── Hub (Admin) URL ─────────────────────────────────────
# Production: https://hub-gamma-umber.vercel.app
# Local Dev:  http://localhost:3004
NEXT_PUBLIC_HUB_URL=https://hub-gamma-umber.vercel.app

# ── JWT Secret (Server-side Next.js API routes only) ────
# MUST match the API server's JWT_SECRET exactly
JWT_SECRET=CHANGE_ME_TO_SAME_AS_API_SERVER

# ── Firebase (FCM Push Notifications) ───────────────────
# Get from: https://console.firebase.google.com
# Project Settings → Your Apps → Web App → Config
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# VAPID Key — Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
# Click "Generate key pair" and copy the "Key pair" value
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database (used by Next.js API routes only) ───────────────────────────────
# Same as API server's DATABASE_URL (pooler URL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/tatka_bazar?pgbouncer=true

# ── App URL ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://rider.tatkabazar.com
