// This is the Prisma schema for Tatka Bazar — the complete data model.
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// IDENTITY TABLES — four structurally separate realms
// =============================================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String    @unique
  name          String
  passwordHash  String
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  b2bAccount    B2BAccount?
  subscriptions Subscription[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs       AuditLog[]
  vendorApprovals Vendor[]        @relation("ApprovedBy")
  riderApprovals  DeliveryRider[] @relation("ApprovedBy")
  riderKycApprovals DeliveryRider[] @relation("RiderKycApproval")

  @@index([email])
  @@map("admin_users")
}

model Vendor {
  id             String       @id @default(uuid())
  email          String       @unique
  phone          String       @unique
  businessName   String
  slug           String       @unique
  passwordHash   String
  description    String?
  logoUrl        String?
  bannerUrl      String?
  status         VendorStatus @default(PENDING)
  commissionRate Float        @default(10) // percent
  isActive       Boolean      @default(true)
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  approvedBy     AdminUser?   @relation("ApprovedBy", fields: [approvedById], references: [id])
  products       Product[]
  branches       Branch[]
  payouts        VendorPayout[]
  commissions    Commission[]
  orderItems     OrderItem[]
  quoteRequests  QuoteRequest[]
  invoices       Invoice[]

  @@index([email])
  @@index([slug])
  @@index([status])
  @@map("vendors")
}

model DeliveryRider {
  id               String              @id @default(uuid())
  email            String              @unique
  phone            String              @unique
  name             String
  passwordHash     String
  vehicleType      VehicleType         @default(BICYCLE)
  vehicleNumber    String?
  nidNumber        String?
  status           RiderStatus         @default(OFFLINE)
  isActive         Boolean             @default(true)
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // KYC Extended Fields
  fatherName       String?
  motherName       String?
  dateOfBirth      DateTime?
  presentAddress   String?
  permanentAddress String?
  nidFrontUrl      String?
  nidBackUrl       String?
  photoUrl         String?
  kycStatus        KycStatus           @default(PENDING)
  kycSubmittedAt   DateTime?
  kycApprovedAt    DateTime?
  kycApprovedById  String?

  // Balance & Earnings
  balance          Decimal             @default(0) @db.Decimal(10, 2)
  totalEarned      Decimal             @default(0) @db.Decimal(10, 2)

  // Payment Account (locked after first submit)
  paymentMethod    PaymentAccountType?
  paymentAccount   String?
  paymentAccountLocked Boolean         @default(false)

  approvedBy       AdminUser?          @relation("ApprovedBy", fields: [approvedById], references: [id])
  kycApprovedBy    AdminUser?          @relation("RiderKycApproval", fields: [kycApprovedById], references: [id])
  assignments      DeliveryAssignment[]
  earningHistory   RiderEarning[]
  withdrawRequests RiderWithdrawal[]

  @@index([email])
  @@index([status])
  @@index([kycStatus])
  @@map("delivery_riders")
}

// =============================================================================
// LOCATION & CATALOGUE
// =============================================================================

model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String?
  line1      String
  line2      String?
  area       String
  city       String
  postCode   String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive, parentId, sortOrder])
  @@map("categories")
}

model Product {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  price        Decimal   @db.Decimal(10, 2)
  comparePrice Decimal?  @db.Decimal(10, 2)
  sku          String?
  stock        Int       @default(0)
  isPublished  Boolean   @default(false)
  isFeatured   Boolean   @default(false)
  categoryId   String
  vendorId     String?   // null = Tatka Bazar's own stock
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category     Category  @relation(fields: [categoryId], references: [id])
  vendor       Vendor?   @relation(fields: [vendorId], references: [id])
  images       ProductImage[]
  pricingRules ProductPricingRule[]
  orderItems   OrderItem[]
  reviews      Review[]

  @@index([categoryId])
  @@index([vendorId])
  @@index([price])
  @@index([slug])
  @@index([createdAt])
  @@index([isPublished])
  @@index([isPublished, categoryId, price])
  @@index([isPublished, isFeatured, createdAt(sort: Desc)])
  @@index([vendorId, isPublished])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductPricingRule {
  id          String   @id @default(uuid())
  productId   String
  label       String
  minQty      Int      @default(1)
  discountPct Float?
  fixedPrice  Decimal? @db.Decimal(10, 2)
  startAt     DateTime?
  endAt       DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_pricing_rules")
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  userId     String
  rating     Int      // 1-5
  title      String?
  body       String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

// =============================================================================
// ORDERS & COMMERCE
// =============================================================================

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  userId          String
  addressId       String
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod
  subtotal        Decimal       @db.Decimal(10, 2)
  deliveryFee     Decimal       @db.Decimal(10, 2) @default(0)
  discount        Decimal       @db.Decimal(10, 2) @default(0)
  total           Decimal       @db.Decimal(10, 2)
  couponId        String?
  note            String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  address         Address       @relation(fields: [addressId], references: [id])
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  deliveryAssignment DeliveryAssignment?
  commissions     Commission[]
  invoice         Invoice?
  riderEarnings   RiderEarning[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  vendorId    String?
  name        String   // snapshot at purchase time
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])

  @@index([orderId])
  @@index([vendorId])
  @@index([orderId, vendorId])
  @@index([productId])
  @@map("order_items")
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  description    String?
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2)
  minOrderValue  Decimal?     @db.Decimal(10, 2)
  maxUses        Int?
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders         Order[]

  @@index([code])
  @@map("coupons")
}

model Commission {
  id          String   @id @default(uuid())
  orderId     String
  vendorId    String
  amount      Decimal  @db.Decimal(10, 2)
  rate        Float
  isPaid      Boolean  @default(false)
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id])
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  @@index([orderId])
  @@index([vendorId])
  @@index([isPaid])
  @@map("commissions")
}

model VendorPayout {
  id          String        @id @default(uuid())
  vendorId    String
  amount      Decimal       @db.Decimal(10, 2)
  status      PayoutStatus  @default(PENDING)
  reference   String?
  note        String?
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  vendor      Vendor        @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([status])
  @@map("vendor_payouts")
}

// =============================================================================
// RIDER PORTAL — EARNINGS, WITHDRAWALS, RATES
// =============================================================================

model RiderEarning {
  id          String        @id @default(uuid())
  riderId     String
  orderId     String?
  amount      Decimal       @db.Decimal(10, 2)
  description String?
  type        EarningType   @default(DELIVERY)
  createdAt   DateTime      @default(now())

  rider       DeliveryRider @relation(fields: [riderId], references: [id])
  order       Order?        @relation(fields: [orderId], references: [id])

  @@index([riderId])
  @@index([riderId, createdAt(sort: Desc)])
  @@map("rider_earnings")
}

model RiderWithdrawal {
  id             String             @id @default(uuid())
  riderId        String
  amount         Decimal            @db.Decimal(10, 2)
  paymentMethod  PaymentAccountType
  paymentAccount String
  status         WithdrawalStatus   @default(PENDING)
  adminNote      String?
  processedById  String?
  processedAt    DateTime?
  proofUrl       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  rider          DeliveryRider      @relation(fields: [riderId], references: [id])

  @@index([riderId])
  @@index([status])
  @@map("rider_withdrawals")
}

model DeliveryRate {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(10, 2)
  note      String?
  isActive  Boolean  @default(true)
  setById   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("delivery_rates")
}

// =============================================================================
// DELIVERY
// =============================================================================

model Branch {
  id          String   @id @default(uuid())
  vendorId    String
  name        String
  phone       String?
  address     String
  area        String
  city        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  deliveryZones DeliveryZone[]

  @@index([vendorId])
  @@map("branches")
}

model DeliveryZone {
  id          String   @id @default(uuid())
  branchId    String
  area        String
  city        String
  deliveryFee Decimal  @db.Decimal(10, 2)
  minDays     Int      @default(1)
  maxDays     Int      @default(3)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("delivery_zones")
}

model DeliveryAssignment {
  id          String             @id @default(uuid())
  orderId     String             @unique
  riderId     String
  status      AssignmentStatus   @default(ASSIGNED)
  assignedAt  DateTime           @default(now())
  pickedAt    DateTime?
  deliveredAt DateTime?
  note        String?

  order       Order              @relation(fields: [orderId], references: [id])
  rider       DeliveryRider      @relation(fields: [riderId], references: [id])

  @@index([riderId])
  @@index([status])
  @@map("delivery_assignments")
}


// =============================================================================
// B2B & ENTERPRISE
// =============================================================================

model B2BAccount {
  id              String    @id @default(uuid())
  userId          String    @unique
  companyName     String
  tradeLicenseNo  String?
  creditLimit     Decimal?  @db.Decimal(12, 2)
  isApproved      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quoteRequests   QuoteRequest[]

  @@map("b2b_accounts")
}

model QuoteRequest {
  id            String      @id @default(uuid())
  b2bAccountId  String
  vendorId      String?
  productId     String?
  quantity      Int
  note          String?
  status        QuoteStatus @default(PENDING)
  quotedPrice   Decimal?    @db.Decimal(10, 2)
  respondedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  b2bAccount    B2BAccount  @relation(fields: [b2bAccountId], references: [id])
  vendor        Vendor?     @relation(fields: [vendorId], references: [id])

  @@index([b2bAccountId])
  @@index([vendorId])
  @@map("quote_requests")
}

model Invoice {
  id          String        @id @default(uuid())
  orderId     String        @unique
  vendorId    String?
  number      String        @unique
  dueAt       DateTime?
  paidAt      DateTime?
  status      InvoiceStatus @default(UNPAID)
  pdfUrl      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order       Order         @relation(fields: [orderId], references: [id])
  vendor      Vendor?       @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@map("invoices")
}

// =============================================================================
// NOTIFICATIONS & AUDIT
// =============================================================================

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  data       Json?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id           String    @id @default(uuid())
  adminUserId  String?
  action       String
  entity       String
  entityId     String?
  oldValues    Json?
  newValues    Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  adminUser    AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Subscription {
  id         String   @id @default(uuid())
  userId     String
  email      String
  type       String   @default("newsletter")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@map("subscriptions")
}

// =============================================================================
// ENUMS
// =============================================================================

enum AdminRole {
  SUPER_ADMIN
  STAFF
  FINANCE
  SUPPORT
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum RiderStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  VAN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BKASH
  NAGAD
  SSLCOMMERZ
  COD
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AssignmentStatus {
  ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum EarningType {
  DELIVERY
  BONUS
  ADJUSTMENT
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum PaymentAccountType {
  BKASH
  NAGAD
  BANK
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT
  DELIVERY
  PROMO
  SYSTEM
}

enum QuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}
