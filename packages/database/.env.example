# =============================================================================
# Tatka Bazar — Database Package Environment Variables
# Used for: prisma migrate dev / prisma migrate deploy
# =============================================================================

# Pooler URL (used by app at runtime via Prisma Client)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/tatka_bazar?pgbouncer=true

# Direct URL (used by Prisma CLI for migrations — must bypass connection pooler)
# For Supabase: use the "Direct connection" URL (port 5432, not 6543)
# For Neon: use the non-pooled URL
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/tatka_bazar
