# =============================================================================
# Tatka Bazar — Environment Variables
# Copy this file to .env and fill in real values.
# =============================================================================

# --- Database ---
DATABASE_URL="postgresql://tatka:tatka_secret@localhost:5432/tatka_bazar"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
JWT_EXPIRY="7d"

# --- API ---
API_PORT=4000
API_HOST="0.0.0.0"

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003"

# --- Frontend app ports (for local dev) ---
STOREFRONT_PORT=3000
ADMIN_PORT=3001
VENDOR_PORT=3002
RIDER_PORT=3003

# --- App public URLs (used in JWT audience check) ---
STOREFRONT_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
VENDOR_URL="http://localhost:3002"
RIDER_URL="http://localhost:3003"
API_URL="http://localhost:4000"

# --- bcrypt ---
BCRYPT_ROUNDS=12

# --- Payment gateways (fill in when integrating) ---
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
NAGAD_MERCHANT_ID=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
